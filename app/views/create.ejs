<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoWaste App</title>
    <link rel="stylesheet" href="/static/styles/style.css">
</head>
<body>

      <!-- Header -->
    <header>
        <div>
            <span class="recycle"></span>
         <a href="index.html" class="logo">
        ♻ EcoWaste
         
    </a>
    </div>

        <a href="council-login.html" class="staff-login">Council Login</a>
    </header>

    <!-- Main Content -->
    <main>

        <section class="hero">
            <h1>Report Waste. Earn Rewards.</h1>
            <p>Help keep Birmingham cleaner by reporting overflowing bins and waste hotspots.</p>
        </section>

        <section class="signup-container">

            <div class="signup-card">

                <h2>Create Account</h2>

                <form>

                    <label>Full Name</label>
                    <input type="text" placeholder="Enter your full name">

                    <label>Username</label>
                    <input type="text" placeholder="Choose a username">

                    <label>Email</label>
                    <input type="email" placeholder="Enter your email">

                    <label>Password</label>
                    <input type="password" placeholder="Create a password">

                    <button type="submit">Create Account</button>

                </form>

                <p class="login-text">
                    Already have an account?
                    <a href="login.html">Login</a>
                </p>

            </div>

        </section>

        <!-- Features -->
        <section class="features">

            <div class="feature-card">
                <h3>🟢 Report Full Bins</h3>
                <p>Quickly report household and street bins.</p>
            </div>

            <div class="feature-card">
                <h3>🔵 Track Issues</h3>
                <p>Help identify waste hotspots in your area.</p>
            </div>

            <div class="feature-card">
                <h3>🏆 Earn Rewards</h3>
                <p>Gain points for helping your community.</p>
            </div>

        </section>

    </main>
    <footer>
    <p>© 2026 WasteApp | Cleaner Streets. Smarter Collections.</p>
</footer>

</body>
</html>
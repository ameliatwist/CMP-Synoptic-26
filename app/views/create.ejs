//displays a leaderboard of users ranked by their points. The page includes a header with navigation links, a main section with the points table, and a footer with copyright information. The points table shows each user's username, full name, total points, and a level based on their points (Eco Starter, Green Champion, Eco Hero). The page also includes Google Translate functionality for multilingual support.
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoWaste | Create Account</title>
    <script src="/static/js/settings.js"></script><link rel="stylesheet" href="/static/styles/style.css">
</head>
<body>

    <header>
        <a href="/login" class="logo">♻ EcoWaste</a>
        <nav></nav>
        <div class="header-right">
            <div id="google_translate_element"></div>
        </div>
    </header>

    <main>

        <section class="hero-text">
            <h1>Report Waste. Earn Rewards.</h1>
            <p>Help keep Birmingham cleaner by reporting overflowing bins and waste hotspots.</p>
        </section>

        <section class="signup-container">
            <div class="signup-card">
                <h2>Create Account</h2>
                <form id="create-form">
                    <div id="messageBox" class="message-box"></div>

                    <label>Full Name</label>
                    <input type="text" placeholder="Enter your full name" id="fullname">

                    <label>Username</label>
                    <input type="text" placeholder="Choose a username" id="username">

                    <label>Email</label>
                    <input type="email" placeholder="Enter your email" id="email">

                    <label>Password</label>
                    <input type="password" placeholder="Create a password (min 8 chars)" id="password">

                    <button type="submit">Create Account</button>
                </form>

                <p class="login-text">
                    Already have an account? <a href="/login">Login</a>
                </p>
            </div>
        </section>

        <section class="features">
            <div class="feature-card">
                <h3>🟢 Report Full Bins</h3>
                <p>Quickly report household and street bins.</p>
            </div>
            <div class="feature-card">
                <h3>🔵 Track Issues</h3>
                <p>Help identify waste hotspots in your area.</p>
            </div>
            <div class="feature-card">
                <h3>🏆 Earn Rewards</h3>
                <p>Gain points for helping your community.</p>
            </div>
        </section>

    </main>

    <footer>
        <p>© 2026 EcoWaste App | Cleaner Streets. Smarter Collections.</p>
    </footer>

    <script src="/static/js/create.js"></script>
    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <script>function googleTranslateElementInit() { new google.translate.TranslateElement({ pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element'); }</script>
</body>
</html>

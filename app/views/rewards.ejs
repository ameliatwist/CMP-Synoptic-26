<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoWaste App Rewards</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header>
    <a href="index.html" class="logo">
        ♻ EcoWaste
    </a>

    <nav>
            <a href="index.html" class="active">Home</a>
            <!-- <a href="council-dashboard.html">Dashboard</a> --- replace with user dashboard --- -->
            <a href="council-routes.html">Routes and Schedule</a>
            <a href="rewards.html">Rewards</a>
</nav>
        </nav>

    <div class="council-title">
        Rewards Dashboard
    </div>
</header>

    <main>

        <!-- Points Summary -->
        <section class="points-section">
            <h1>🏆 Rewards Dashboard</h1>

            <div class="points-card">
                <h2>1,250 Points</h2>
                <p>Level: Green Champion 🌱</p>

                <div class="progress-bar">
                    <div class="progress"></div>
                </div>

                <p>750 points until Eco Hero</p>
            </div>
        </section>

        <!-- Rewards -->
        <section class="rewards-container">

            <div class="reward-card">
                <h3>☕ Coffee Voucher</h3>
                <p>500 Points</p>
                <button>Redeem</button>
            </div>

            <div class="reward-card">
                <h3>🌳 Plant a Tree</h3>
                <p>1000 Points</p>
                <button>Redeem</button>
            </div>

            <div class="reward-card">
                <h3>🎁 Gift Card</h3>
                <p>1500 Points</p>
                <button>Redeem</button>
            </div>

            <div class="reward-card">
                <h3>🏅 Eco Hero Badge</h3>
                <p>2000 Points</p>
                <button>Redeem</button>
            </div>

        </section>

        <!-- Achievements -->
        <section class="achievements">

            <h2>Achievements</h2>

            <div class="badge-container">
                <div class="badge">🏅 First Report</div>
                <div class="badge">🟢 10 Verified Reports</div>
                <div class="badge">🌍 Community Helper</div>
                <div class="badge">♻ Recycling Champion</div>
            </div>

        </section>

        <!-- Community Impact -->
        <section class="impact">

            <h2>Community Impact</h2>

            <div class="impact-card">
                <p>✔ 42 Overflowing Bins Reported</p>
                <p>✔ 18 Waste Hotspots Cleared</p>
                <p>✔ 120 Collection Issues Resolved</p>
            </div>

        </section>

    </main>

    <footer>
        <p>© 2026 EcoWaste App | Built for a cleaner environment</p>
    </footer>

</body>
</html>
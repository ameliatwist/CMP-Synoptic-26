<!DOCTYPE html>
<html>
<head>
    <title>WasteApp Dashboard</title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="stylesheet" href="/styles/dashboard.css">
</head>

<body>

<nav class="sidebar">
    <ul>
        <li><a href="/">🏠 Dashboard</a></li>
        <li><a href="/reportBin">🗑 Report Bin</a></li>
        <li><a href="/rota">📅 Rota</a></li>
        <li><a href="/rewards">🎁 Rewards</a></li>
        <li><a href="/learn">♻ Learn</a></li>
        <li><a href="/help">❓ Help</a></li>
        <li><a href="/profile">👤 Profile</a></li>
    </ul>
</nav>

<header class="topbar">
    <div class="logo">♻️</div>

    <h1>WasteApp</h1>

    <div class="header-actions">
        <a href="/help" class="help-btn">
            <i class="fa-solid fa-circle-question"></i>
        </a>

        <a href="/profile" class="profile-btn">
            <i class="fa-solid fa-user"></i>
        </a>

        <button class="burger-btn">☰</button>
    </div>
</header>

<main class="dashboard">

    <aside class="points-card">
        <p>Good morning,<br><%= userName %></p>

        <div class="star">★</div>

        <h3>Current points</h3>
        <p class="points"><%= points %></p>
    </aside>

    <section class="actions">

        <a href="/report" class="action-card">
            <span>🗑️</span>
            <p>Report waste bin</p>
        </a>

        <a href="/rota" class="action-card">
            <span>📅</span>
            <p>Collection rota</p>
        </a>

        <a href="/rewards" class="action-card">
            <span>🎁</span>
            <p>Rewards</p>
        </a>

        <a href="/learn" class="action-card">
            <span>♻️</span>
            <p>Learn</p>
        </a>

    </section>

    <aside class="reports">
        <h2>Recent reports</h2>

        <% reports.forEach(report => { %>
            <div class="report-item">
                <strong><%= report.type %></strong>
                <p><%= report.location %></p>
                <small><%= report.status %></small>
            </div>
        <% }) %>
    </aside>

</main>

<footer class="footer">
    <div class="footer-content">

        <div class="footer-section">
            <h3>WasteApp</h3>
            <p>Helping communities keep their environment clean.</p>
        </div>

        <div class="footer-section">
            <h3>Contact Us</h3>
            <p>For any queries contact us:</p>

            <div class="socials">
                <a href="https://facebook.com" target="_blank">
                    <i class="fa-brands fa-facebook fa-2x"></i>
                </a>

                <a href="https://twitter.com" target="_blank">
                    <i class="fa-brands fa-x-twitter fa-2x"></i>
                </a>

                <a href="https://instagram.com" target="_blank">
                    <i class="fa-brands fa-instagram fa-2x"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">
        &copy; 2026 WasteApp. All Rights Reserved.
    </div>
</footer>

<script src="/js/burger.js"></script>
<script src="/js/setting.js"></script>

</body>
</html>